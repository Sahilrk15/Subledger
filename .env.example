# Copy this file to .env for a local (non-Docker) run:  cp .env.example .env
# Local default: SQLite file, nothing to install.
DATABASE_URL=sqlite:///./subledger.db

# To use a local PostgreSQL instead, for example:
# DATABASE_URL=postgresql+psycopg2://subledger:subledger@localhost:5432/subledger

# An invoice is due this many days after it is issued.
INVOICE_DUE_DAYS=7
